{
  "name": "cucina",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "app": "npm run icons && tauri dev",
    "dist": "npm run icons && npm run cli:build && tauri build",
    "cli:build": "cargo build --release -p cucina-cli",
    "cli:install": "npm run cli:build && mkdir -p ~/.local/bin && ln -sf \"$PWD/target/release/cucina-cli\" ~/.local/bin/cucina && echo 'cucina installed to ~/.local/bin'",
    "fonts": "node scripts/fetch-fonts.mjs",
    "icons:app": "tauri icon assets/icon-source.png"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
