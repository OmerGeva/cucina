{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cucina",
  "version": "0.1.0",
  "identifier": "com.omergeva.cucina",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cucina",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#F0E7D6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 700,
          "height": 440
        },
        "appPosition": {
          "x": 215,
          "y": 268
        },
        "applicationFolderPosition": {
          "x": 505,
          "y": 268
        }
      }
    },
    "resources": {
      "../target/release/cucina-cli": "cucina-cli"
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "Cucina",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFNTZFN0YxODY5QjU0MDgKUldRSVZKdUc4ZWRXTGhRZ3FxN1IvaVVlQ1BCSlMxSkVCK2ZVMFpvWG5BOHQxSW1pTmpTUGxvNy8K",
      "endpoints": [
        "https://github.com/OmerGeva/cucina/releases/latest/download/latest.json"
      ]
    }
  }
}
